# Copy to `.env` for local development (never commit `.env`).
# In production, set these in Netlify → Site configuration → Environment variables.

# Required: your SunoAPI.org key (https://sunoapi.org/api-key). Server-side only.
SUNO_API_KEY=

# Recommended: shared access code users must enter before generating. Protects your credits.
APP_ACCESS_CODE=

# Optional: max generation requests per UTC day for the whole site (default 50, 0 = unlimited).
DAILY_GENERATION_LIMIT=50

# Optional: set to "true" to use the built-in mock API (no credits spent, no key needed).
SUNO_MOCK=false

# Optional overrides (rarely needed).
# SUNO_API_BASE_URL=https://api.sunoapi.org
# SUNO_CALLBACK_URL=https://your-site.netlify.app/api/suno-callback
